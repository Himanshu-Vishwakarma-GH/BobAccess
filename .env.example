# BobAccess Environment Configuration

# Application Settings
APP_NAME=BobAccess
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# IBM Watson Services (TTS / STT)
# If left empty, fallback local engines (pyttsx3 & Web Speech API) are automatically used
IBM_WATSON_TTS_APIKEY=
IBM_WATSON_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com
IBM_WATSON_STT_APIKEY=
IBM_WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# IBM watsonx.ai Credentials (Optional for Granite LLM RAG)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Chroma Vector Database
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
